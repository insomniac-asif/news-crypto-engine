[Unit]
Description=Crypto News Engine Dashboard (FastAPI)
After=network.target

[Service]
Type=simple
User=USERNAME
WorkingDirectory=/home/USERNAME/news-crypto-engine
ExecStart=/home/USERNAME/news-crypto-engine/venv/bin/python -m uvicorn dashboard_fastapi.app:app --host 0.0.0.0 --port 8091
Restart=always
RestartSec=10
Environment=PATH=/home/USERNAME/news-crypto-engine/venv/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
